{
  "name": "goat-minify",
  "version": "2.4.3",
  "description": "Client-side code minification tool supporting JS, CSS, HTML, XML, JSON, YAML, TOML, and Markdown",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write \"**/*.{js,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,md}\"",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dcog989/Goat-Minify"
  },
  "keywords": [
    "code-tool",
    "css",
    "html",
    "javascript",
    "minifier",
    "minify",
    "offline",
    "postcss",
    "web-app"
  ],
  "author": "Chase McGoat",
  "license": "MIT",
  "dependencies": {
    "cssnano": "^7.1.9",
    "highlight.js": "^11.12.0",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.5.28",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@vitest/ui": "^5.0",
    "buffer": "^6.0.3",
    "eslint-config-prettier": "^10.1.8",
    "events": "^3.3.0",
    "globals": "^17.0",
    "jsdom": "^30.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vite": "^8.2",
    "vitest": "^5.0.0"
  }
}
