{
  "name": "goat-minify",
  "author": "Chase McGoat",
  "description": "Client-side code minification tool supporting JS, CSS, HTML, XML, JSON, YAML, TOML, and Markdown",
  "license": "MIT",
  "type": "module",
  "version": "2.4.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/dcog989/Goat-Minify"
  },
  "keywords": [
    "code-tool",
    "css",
    "html",
    "javascript",
    "minifier",
    "minify",
    "offline",
    "postcss",
    "web-app"
  ],
  "scripts": {
    "build": "vite build",
    "changelog": "cog changelog",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "rm -rf dist .biome",
    "commit": "cog commit",
    "dev": "vite",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "preview": "vite preview",
    "release": "cog bump --auto",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "cssnano": "^9.0.4",
    "highlight.js": "^11.12.0",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.5.28",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@vitest/ui": "^5.0.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
